<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="2025-12-26 users and logons" author="Sabadin Ivan" context="dev">
        <createTable tableName="sec_users" remarks="Пользователи системы">
            <column name="id" remarks="Идентификатор сущности" type="java.sql.Types.BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_user"/>
            </column>
            <column name="version" remarks="Версия сущности" type="java.sql.Types.INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="create_at" remarks="Дата создания версии сущности" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" remarks="Автор создания версии сущности" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" remarks="Имя пользователя" type="java.sql.Types.VARCHAR">
                <constraints nullable="true"/>
            </column>
            <column name="last_name" remarks="Фамилия пользователя" type="java.sql.Types.VARCHAR">
                <constraints nullable="true"/>
            </column>
            <column name="middle_name" remarks="Отчество пользователя" type="java.sql.Types.VARCHAR">
                <constraints nullable="true"/>
            </column>
            <column name="email" remarks="Почтовый ящик пользователя" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="logon_name" remarks="Имя для входа в систему" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="password" remarks="Хэш пароля" type="java.sql.Types.VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="role" remarks="Роль пользователя" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" remarks="Актуальность" type="java.sql.Types.BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql">select setval('sec_users_id_seq', ${id.start.value});</sql>
    </changeSet>

    <changeSet id="2026-01-22 creating task entity" author="Sabadin Ivan" context="dev">
        <createTable tableName="tsk_comments" remarks="Комментарий к задаче">
            <column name="id" remarks="Идентификатор сущности" type="java.sql.Types.BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tsk_comment"/>
            </column>
            <column name="version" remarks="Версия сущности" type="java.sql.Types.INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="create_at" remarks="Дата создания версии сущности" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" remarks="Автор создания версии сущности" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" remarks="Внешний идентификатор автора комментария" type="java.sql.Types.BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="task_id" remarks="Внешний идентификатор задачи" type="java.sql.Types.BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" remarks="Комментарий к задаче" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" remarks="Актуальность" type="java.sql.Types.BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql">select setval('tsk_comments_id_seq', ${id.start.value});</sql>

        <createTable tableName="tsk_tasks" remarks="Сущность задачи">
            <column name="id" remarks="Идентификатор сущности" type="java.sql.Types.BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tsk_task"/>
            </column>
            <column name="version" remarks="Версия сущности" type="java.sql.Types.INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="create_at" remarks="Дата создания версии сущности" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" remarks="Автор создания версии сущности" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="initiator_id" remarks="Внешний идентификатор инициатора задачи" type="java.sql.Types.BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" remarks="Наименование (заголовок) задачи" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="description" remarks="Описание задачи" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="executor_id" remarks="Внешний идентификатор исполнителя задачи" type="java.sql.Types.BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="status" remarks="Статус задачи" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="team_id" remarks="Внешний идентификатор команды исполниелей" type="java.sql.Types.BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql">select setval('tsk_tasks_id_seq', ${id.start.value});</sql>
    </changeSet>

    <changeSet id="2026-02-06 creating team entity" author="Sabadin Ivan" context="dev">
        <createTable tableName="tm_teams" remarks="Сущность команды">
            <column name="id" remarks="Идентификатор сущности" type="java.sql.Types.BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tm_team"/>
            </column>
            <column name="version" remarks="Версия сущности" type="java.sql.Types.INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="create_at" remarks="Дата создания версии сущности" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="create_by" remarks="Автор создания версии сущности" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="creator_id" remarks="Внешний идентификатор создателя команды" type="java.sql.Types.BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title_team" remarks="Наименование (заголовок) команды" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="type_team" remarks="Тип команды (SOLO(1), SMALL(2-5), TEAM(6+))" type="java.sql.Types.VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" remarks="Актуальность" type="java.sql.Types.BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql dbms="postgresql">select setval('tm_teams_id_seq', ${id.start.value});</sql>
    </changeSet>

    <changeSet id="2026-02-11" author="Sabadin Ivan">
    <createTable tableName="rel_teams_users" remarks="Связь: команда и пользователь">
        <column name="rel_team_id" remarks="Идентификатор команды" type="java.sql.Types.BIGINT">
            <constraints primaryKey="true" primaryKeyName="pk_rel_team_user"
                         foreignKeyName="fk_team_id"
                         referencedTableName="tm_teams" referencedColumnNames="id"/>
        </column>
        <column name="rel_user_id" remarks="Идентификатор пользователя" type="java.sql.Types.BIGINT">
            <constraints primaryKey="true" primaryKeyName="pk_rel_team_user"
                         foreignKeyName="fk_user_id"
                         referencedTableName="sec_users" referencedColumnNames="id"/>
        </column>
    </createTable>
</changeSet>

</databaseChangeLog>